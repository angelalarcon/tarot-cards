rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'angelalarcon.aa@gmail.com',
          'anaislegonia@gmail.com'
        ];
    }

    // Write-only session telemetry — anyone may create, nobody may read/modify/delete
    // from the client (reads happen via the Firebase console / admin SDK only).
    match /sessions/{sessionId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Public shared-reading feature — anyone with a share link may view/create/update.
    match /readings/{code} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Client records — only the allowlisted admin Google accounts.
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }
  }
}
